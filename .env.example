# Local OpenAI-compatible LLM (Ollama / llama.cpp / vLLM / LM Studio)
LOCAL_LLM_URL="http://192.168.4.20:11434/v1/"
LOCAL_LLM_MODEL="qwen2.5:7b"
LOCAL_LLM_API_KEY=""

# APP_URL: Optional public URL where this app is hosted.
APP_URL="MY_APP_URL"

# Self-hosting server port (defaults to 3089 outside AI Studio dev sandbox)
CAPITOL_PORT=3089

# Optional custom SQLite database location (defaults to ./data/capitol_ledger.db)
CAPITOL_DB_PATH="./data/capitol_ledger.db"

# Keep existing database records untouched without injecting starter sample rows
SKIP_SEED_ON_EXISTING_DB=true
